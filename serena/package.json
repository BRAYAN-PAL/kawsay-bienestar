{
  "name": "kawsay-bienestar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "worker": "node --env-file-if-exists=.env worker.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check lib/core.mjs && node --check lib/providers.mjs && node --check dist/app.js && node --check dist/portal.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
