# Desarrollo local: SQLite automático. Render: DATABASE_URL de Supabase obligatoria.
NODE_ENV=development
PORT=4173
APP_URL=http://127.0.0.1:4173
DATABASE_URL=
# Adaptador recomendado Supabase Data API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
KAWSAY_DB_SECRET=
# Usa valores aleatorios largos en Render (no los subas al repositorio).
AUDIT_SECRET=
BOOTSTRAP_TOKEN=
CRON_SECRET=
# La cuenta administradora se crea en la pantalla inicial.
# IA: ollama, openai o disabled. Solo el servidor accede a las claves.
AI_PROVIDER=disabled
# Proveedor elegido: AI_PROVIDER=nvidia. Clave solo en Render o .env privado.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_BRIDGE_SECRET=
RENDER_APP_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# WhatsApp Cloud API. Desactivado hasta completar credenciales y plantillas.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE=recordatorio_cita
WHATSAPP_LANGUAGE=es_PE
